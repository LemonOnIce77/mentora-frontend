generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int

  @@index([expiration], map: "cache_expiration_index")
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int

  @@index([expiration], map: "cache_locks_expiration_index")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String  @db.LongText
  options        String? @db.MediumText
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String @db.VarChar(255)
  payload      String @db.LongText
  attempts     Int    @db.UnsignedTinyInt
  reserved_at  Int?   @db.UnsignedInt
  available_at Int    @db.UnsignedInt
  created_at   Int    @db.UnsignedInt

  @@index([queue], map: "jobs_queue_index")
}

model mentor_applications {
  id                                           BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                                      BigInt                     @db.UnsignedBigInt
  alasan_mengajar                              String                     @db.Text
  bidang_keahlian                              String                     @db.VarChar(255)
  tahun_pengalaman                             Int                        @default(1)
  tautan_portofolio                            String?                    @db.VarChar(255)
  status                                       mentor_applications_status @default(PENDING)
  catatan_admin                                String?                    @db.Text
  reviewed_by                                  BigInt?                    @db.UnsignedBigInt
  reviewed_at                                  DateTime?                  @db.Timestamp(0)
  created_at                                   DateTime?                  @db.Timestamp(0)
  updated_at                                   DateTime?                  @db.Timestamp(0)
  users_mentor_applications_reviewed_byTousers users?                     @relation("mentor_applications_reviewed_byTousers", fields: [reviewed_by], references: [id], onUpdate: Restrict, map: "mentor_applications_reviewed_by_foreign")
  users_mentor_applications_user_idTousers     users                      @relation("mentor_applications_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "mentor_applications_user_id_foreign")
  mentor_credentials                           mentor_credentials[]

  @@index([reviewed_by], map: "mentor_applications_reviewed_by_foreign")
  @@index([status], map: "mentor_applications_status_index")
  @@index([user_id, status], map: "mentor_applications_user_id_status_index")
}

model mentor_credentials {
  id                    BigInt                               @id @default(autoincrement()) @db.UnsignedBigInt
  user_id               BigInt                               @db.UnsignedBigInt
  mentor_application_id BigInt?                              @db.UnsignedBigInt
  jenis_dokumen         mentor_credentials_jenis_dokumen
  judul_dokumen         String                               @db.VarChar(255)
  file_path             String                               @db.VarChar(255)
  file_name             String                               @db.VarChar(255)
  file_size             BigInt                               @db.UnsignedBigInt
  mime_type             String                               @db.VarChar(255)
  status_verifikasi     mentor_credentials_status_verifikasi @default(PENDING)
  created_at            DateTime?                            @db.Timestamp(0)
  updated_at            DateTime?                            @db.Timestamp(0)
  mentor_applications   mentor_applications?                 @relation(fields: [mentor_application_id], references: [id], onUpdate: Restrict, map: "mentor_credentials_mentor_application_id_foreign")
  users                 users                                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "mentor_credentials_user_id_foreign")

  @@index([mentor_application_id], map: "mentor_credentials_mentor_application_id_foreign")
  @@index([status_verifikasi], map: "mentor_credentials_status_verifikasi_index")
  @@index([user_id, jenis_dokumen], map: "mentor_credentials_user_id_jenis_dokumen_index")
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenable_type String    @db.VarChar(255)
  tokenable_id   BigInt    @db.UnsignedBigInt
  name           String    @db.Text
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?   @db.Text
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([expires_at], map: "personal_access_tokens_expires_at_index")
  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model skills {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  nama_skill  String        @unique(map: "skills_nama_skill_unique") @db.VarChar(255)
  kategori    String        @db.VarChar(255)
  deskripsi   String?       @db.Text
  icon        String?       @db.VarChar(255)
  created_at  DateTime?     @db.Timestamp(0)
  updated_at  DateTime?     @db.Timestamp(0)
  user_skills user_skills[]

  @@index([kategori], map: "skills_kategori_index")
}

model user_skills {
  id                   BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  user_id              BigInt            @db.UnsignedBigInt
  skill_id             BigInt            @db.UnsignedBigInt
  type                 user_skills_type
  level                user_skills_level @default(pemula)
  deskripsi_pengalaman String?           @db.Text
  created_at           DateTime?         @db.Timestamp(0)
  updated_at           DateTime?         @db.Timestamp(0)
  skills               skills            @relation(fields: [skill_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_skills_skill_id_foreign")
  users                users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_skills_user_id_foreign")

  @@unique([user_id, skill_id, type], map: "user_skill_type_unique")
  @@index([skill_id], map: "user_skills_skill_id_foreign")
  @@index([user_id, type], map: "user_skills_user_id_type_index")
}

model users {
  id                                                         BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  nama_lengkap                                               String                @db.VarChar(255)
  nama_panggilan                                             String?               @db.VarChar(255)
  email                                                      String                @unique(map: "users_email_unique") @db.VarChar(255)
  email_verified_at                                          DateTime?             @db.Timestamp(0)
  password                                                   String                @db.VarChar(255)
  universitas                                                String?               @db.VarChar(255)
  prodi                                                      String?               @db.VarChar(255)
  semester                                                   String?               @db.VarChar(255)
  domisili                                                   String?               @db.VarChar(255)
  tgl_lahir                                                  String?               @db.VarChar(255)
  bio                                                        String?               @db.Text
  foto_profil                                                String?               @db.VarChar(255)
  mode_sesi                                                  String                @default("Fleksibel") @db.VarChar(255)
  role                                                       String                @default("Mentee") @db.VarChar(255)
  status_mentor                                              String                @default("NONE") @db.VarChar(255)
  dokumen_kredensial                                         String?               @db.VarChar(255)
  total_poin                                                 Int                   @default(0)
  latitude                                                   Float?
  longitude                                                  Float?
  onboarding_completed                                       Boolean               @default(false)
  remember_token                                             String?               @db.VarChar(100)
  created_at                                                 DateTime?             @db.Timestamp(0)
  updated_at                                                 DateTime?             @db.Timestamp(0)
  mentor_applications_mentor_applications_reviewed_byTousers mentor_applications[] @relation("mentor_applications_reviewed_byTousers")
  mentor_applications_mentor_applications_user_idTousers     mentor_applications[] @relation("mentor_applications_user_idTousers")
  mentor_credentials                                         mentor_credentials[]
  user_skills                                                user_skills[]

  @@index([role], map: "users_role_index")
  @@index([status_mentor], map: "users_status_mentor_index")
}

enum mentor_credentials_jenis_dokumen {
  transkrip
  sertifikat
  portofolio
}

enum user_skills_type {
  teach
  learn
}

enum user_skills_level {
  pemula
  menengah
  mahir
}

enum mentor_applications_status {
  PENDING
  APPROVED
  REJECTED
}

enum mentor_credentials_status_verifikasi {
  PENDING
  VALID
  INVALID
}
